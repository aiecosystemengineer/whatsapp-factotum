# API key for the LLM provider chosen in factotum.config.json (llm.provider).
# Only the key matching your provider is needed. With no key, the built-in
# keyword heuristic is used instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# Optional: token if your ntfy.sh topic is protected / you self-host ntfy
NTFY_TOKEN=
